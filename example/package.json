{
  "name": "@animatereactnative/skia-loaders-example",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/SkiaLoadersExample.xcworkspace -UseNewBuildSystem=YES -scheme SkiaLoadersExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -DtestBuildType=debug -Dorg.gradle.jvmargs=-Xmx4g",
    "build:web": "expo export --platform web",
    "postinstall": "mkdir -p public && cp \"$(node -p \"require.resolve('canvaskit-wasm/bin/full/canvaskit.wasm', { paths: [require.resolve('@shopify/react-native-skia')] })\")\" public/canvaskit.wasm"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "private": true,
  "devDependencies": {
    "react-native-builder-bob": "^0.43.0",
    "react-native-monorepo-config": "^0.4.0"
  }
}
